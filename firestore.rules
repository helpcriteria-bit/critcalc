rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & ownership verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidCanvasName(name) {
      return name is string && name.size() > 0 && name.size() <= 200;
    }

    function isValidCanvasData(data) {
      return data is map
        && data.keys().hasOnly(['geoObjects', 'gridSettings', 'transform'])
        && data.keys().hasAll(['geoObjects', 'gridSettings', 'transform'])
        && data.geoObjects is list
        && data.geoObjects.size() <= 200
        && data.gridSettings is map
        && data.transform is map;
    }

    function isValidThumbnail(data) {
      return !data.keys().hasAny(['thumbnail'])
        || data.thumbnail == null
        || (data.thumbnail is string && data.thumbnail.size() <= 300000);
    }

    function isValidCanvasDocument(data) {
      return data.keys().hasOnly(['userId', 'name', 'canvasData', 'thumbnail', 'createdAt', 'updatedAt'])
        && isValidCanvasName(data.name)
        && isValidCanvasData(data.canvasData)
        && isValidThumbnail(data);
    }

    // User Profile Document: users/{userId}
    // Authenticated users can only read and update their own user record
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Student Canvases Collection: users/{userId}/canvases/{canvasId}
    match /users/{userId}/canvases/{canvasId} {
      // Students can only read and list their own saved canvases
      allow read: if isOwner(userId);

      // Students can only create canvases inside their own namespace with valid data and matching userId
      allow create: if isOwner(userId)
                    && request.resource.data.userId == request.auth.uid
                    && isValidCanvasDocument(request.resource.data);

      // Students can only update their own canvases; ownership cannot be reassigned
      allow update: if isOwner(userId)
                    && request.resource.data.get('userId', userId) == userId
                    && isValidCanvasDocument(request.resource.data);

      // Students can only delete their own canvases
      allow delete: if isOwner(userId);
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
